# Copy these values into Streamlit Community Cloud > App settings > Secrets
GEMINI_API_KEY = "your_gemini_api_key_here"

# REQUIRED: the Streamlit app refuses to run without PostgreSQL + pgvector.
# Ingest real_data/ into this exact database before deploying.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
