# Required
GEMINI_API_KEY=your_gemini_api_key_here

# Course identity (content/PDF can change without redesigning the UI)
COURSE_TITLE=อัลกอริทึมการเรียงลำดับข้อมูล
COURSE_LEVEL=มหาวิทยาลัยปีที่ 1
TUTOR_NAME=Sorty
MASCOT_EMOJI=✦

# Lightweight student profile/history
PROFILE_ENABLED=true
RECENT_QUESTION_LIMIT=6

# Generation
GEMINI_MODEL=gemini-3.5-flash-lite

# Retrieval embeddings
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_EMBEDDING_DIM=768

# Optional future multimodal/image embeddings
GEMINI_MULTIMODAL_EMBEDDING_MODEL=gemini-embedding-2

# PostgreSQL + pgvector (recommended for deployment)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Retrieval tuning
RAG_TOP_K=5
RAG_CANDIDATE_K=18
RAG_MIN_SCORE=0.42
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=180
RAG_HISTORY_MESSAGES=6

# Keep false on Streamlit: ingest once with python -m scripts.ingest_pdf instead.
RAG_AUTO_INGEST=false
RAG_ALLOW_MEMORY_FALLBACK=false

# PDF image support — INTERNAL real_data/ visuals only.
# No web/external image search is allowed.
RAG_EXTRACT_IMAGES=true
# Render original PDF pages when vector drawings/diagrams/tables are present.
RAG_RENDER_VECTOR_PAGES=true
# Page-linked image retrieval is the default; multimodal image vectors are optional.
RAG_INDEX_IMAGES=false
RAG_MAX_IMAGES_PER_ANSWER=3

# Generation latency guard
RAG_GENERATION_TIMEOUT_MS=12000
RAG_GENERATION_MAX_OUTPUT_TOKENS=700
